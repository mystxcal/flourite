    class OP,INBOX,SOURCE,CHARTER,CONTRACT authority;
    class ARTIFACT,SPINE,OBLIG,FRONTIER,OBSERVE,GRADIENT,RECOVERY crystal;
    class MAP,LENS,CAP,CONTINUE,TRANSITION frontier;
    class QUESTION,MOVE,GOVERN decision;
    class RECEIPT,KEEPER evidence;
    class SYNTH,SEMCI,CASE,CHALLENGE release;
    class LOCAL,UPSTREAM repair;
    class SEALED sealed;
    class COORD,F_LOOP,ACTION,CAPSULE,PROVIDER,MODEL,CHECKPOINT,PIPELINE,ADAPTERS runtime;
    class INTENT,START,FINISH,SEMANTIC,JOURNAL,PROJECT,STATE,SNAPSHOT truth;
    class LEDGER,BLOBS store;
    class INV invariant;


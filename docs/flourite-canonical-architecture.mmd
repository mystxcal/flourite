flowchart TB
    %% Flourite's conceptual object and the executable architecture beneath it.

    subgraph AUTH["01 · FIXED AUTHORITY"]
        direction LR
        OP["<b>Operator</b><br/><span>task · amendments · hard envelope<br/>pause · resume · stop · steer</span>"]
        INBOX[("<b>Durable control inbox</b><br/><span>commands enter only<br/>at safe boundaries</span>")]
        SOURCE["<b>Immutable Task Source</b><br/><span>exact request + amendments<br/>content-addressed provenance</span>"]
        CHARTER["<b>Task Charter</b><br/><span>revisable interpretation<br/>requirements traced to source</span>"]
        CONTRACT["<b>Goal contract</b><br/><span>deliverable · constraints · stakes<br/>evidence required for release</span>"]
        OP --> INBOX --> SOURCE --> CHARTER --> CONTRACT
    end

    subgraph CRYSTAL["02 · ONE EVOLVING SEMANTIC CRYSTAL  Xₜ"]
        direction LR
        ARTIFACT["<b>Aₜ · Authoritative artifact</b><br/><span>one current best answer<br/>every accepted gain lands here</span>"]
        SPINE["<b>Sₜ · Artifact Spine</b><br/><span>mechanism · key decisions<br/>revisable commitments + retirements</span>"]
        OBLIG["<b>Oₜ · Release obligations</b><br/><span>what must become true<br/>acceptance + evidence boundary</span>"]
        FRONTIER["<b>Fₜ · Frontier Kernel</b><br/><span>controlling bottleneck · active cruxes<br/>live / eliminated families · next move</span>"]
        OBSERVE["<b>Ωₜ + Eₜ · Observation &amp; evidence</b><br/><span>right modality · provenance · scope<br/>what it proves / cannot prove</span>"]
        GRADIENT["<b>Gₜ · Causal gradient</b><br/><span>quality · epistemic · feasibility<br/>exploration · reliability · cost</span>"]
        RECOVERY["<b>Bₜ + Rₜ · Compute &amp; recovery</b><br/><span>earned horizon · bounded commitment<br/>earliest falsified boundary</span>"]
        ARTIFACT --> SPINE --> OBLIG --> FRONTIER --> OBSERVE --> GRADIENT --> RECOVERY
    end

    subgraph LOOP["03 · THE INTELLIGENCE LOOP — MAP → CHOOSE → ZOOM → ACT → INTEGRATE"]
        direction LR
        MAP["<b>Loss-aware frontier map</b><br/><span>task · spine · debt · evidence<br/>constant attention budget</span>"]
        QUESTION{"<b>Highest-value question</b><br/><span>consequence × discrimination × unlock<br/>× potency × reversibility ÷ cost</span>"}
        LENS["<b>Question-specific lens</b><br/><span>map + exact zoom + known omissions<br/>paths to lossless source material</span>"]
        MOVE{"<b>Model chooses the move</b><br/><span>most direct potent method<br/>after question and view are fixed</span>"}
        CAP["<b>Full capability plane</b><br/><span>reason · retrieve · shell · code · browser<br/>media · instruments · bounded workers</span>"]
        RECEIPT["<b>Durable action receipt</b><br/><span>result · scope · trace · actual cost<br/>decision effect · limits · residue</span>"]
        KEEPER["<b>Frontier Keeper</b><br/><span>accept · reject · reopen · compress<br/>integrate meaning exactly once</span>"]
        GOVERN{"<b>Resource governor</b><br/><span>causal movement or<br/>valid commitment?</span>"}
        MAP --> QUESTION --> LENS --> MOVE --> RECEIPT --> KEEPER --> GOVERN
        CAP --> MOVE
    end

    subgraph HORIZON["CAUSAL CONTINUATION — NOT A FIXED CEREMONY"]
        direction LR
        CONTINUE["<b>Earn one more work horizon</b><br/><span>minimum sufficient next slate<br/>completion capacity protected</span>"]
        TRANSITION["<b>Xₜ → Xₜ₊₁</b><br/><span>artifact · spine · frontier · evidence<br/>gradient · commitments · recovery</span>"]
        CONVERGE["<b>Converge</b><br/><span>no useful horizon remains<br/>release debt is now the bottleneck</span>"]
        CONTINUE --> TRANSITION
    end

    subgraph RELEASE["04 · RELEASE MEMBRANE — CLAIMS MAY LEAVE ONLY THROUGH HERE"]
        direction LR
        SYNTH["<b>Clean synthesis</b><br/><span>rebuild from accepted state<br/>one coherent final proposition</span>"]
        SEMCI["<b>Semantic CI</b><br/><span>task fidelity · Spine preservation<br/>deterministic checks</span>"]
        CASE["<b>Completion Case</b><br/><span>obligation-by-obligation evidence<br/>assumptions · uncertainty · reopen rules</span>"]
        CHALLENGE{"<b>Fresh artifact-bound challenge</b><br/><span>exact digest · real modalities<br/>material failures only</span>"}
        LOCAL["<b>Bounded local repair</b><br/><span>fix the defect only<br/>then face a fresh challenge</span>"]
        UPSTREAM["<b>Backpropagate upstream</b><br/><span>reobserve · reconstruct · reframe<br/>retire bad commitments + dependants</span>"]
        SEALED["<b>Sealed result</b><br/><span>verified artifact + audit trail<br/>external mutation stays explicit</span>"]
        SYNTH --> SEMCI --> CASE --> CHALLENGE -->|survives| SEALED
        CHALLENGE -->|local / sequence| LOCAL
        CHALLENGE -->|architecture / frame / observation| UPSTREAM
    end

    subgraph RUNTIME["05 · EXECUTABLE OWNERSHIP — POLICY AND MECHANISM STAY SEPARATE"]
        direction LR
        COORD["<b>RunCoordinator</b><br/><span>resume safely · cross semantic phases<br/>never decides what evidence means</span>"]
        F_LOOP["<b>FrontierLoop</b><br/><span>sparse selection · completion reserve<br/>another horizon or convergence</span>"]
        ACTION["<b>ActionExecutor</b><br/><span>intent → attempt → observation<br/>never mutates shared state directly</span>"]
        CAPSULE["<b>CapsuleBuilder</b><br/><span>typed CapsuleSpec → scoped view<br/>exact lens retained as a blob</span>"]
        PROVIDER["<b>ProviderCallExecutor</b><br/><span>request · retries · reconstruction<br/>telemetry · schema · raw trace</span>"]
        MODEL["<b>Model provider</b><br/><span>bounded cognitive execution<br/>response + usage + raw boundary</span>"]
        CHECKPOINT["<b>CheckpointExecutor</b><br/><span>semantic projection · plan compilation<br/>one validated commit</span>"]
        PIPELINE["<b>ReleasePolicy + Pipeline</b><br/><span>fresh challenge · causal routing<br/>fail-closed mutation gate</span>"]
        ADAPTERS["<b>Artifact adapters</b><br/><span>capture · measure · check · materialize<br/>domain translation, never policy</span>"]
        COORD --> F_LOOP --> ACTION --> CAPSULE --> PROVIDER --> MODEL
        ACTION --> CHECKPOINT
        COORD --> PIPELINE
        ADAPTERS --> ACTION
        ADAPTERS --> PIPELINE
    end

    subgraph TRUTH["06 · LOSSLESS FOUNDATION — THE ONLY AUTHORITATIVE WRITE PATH"]
        direction LR
        INTENT["<b>Intent</b>"]
        START["<b>attempt.started</b>"]
        FINISH["<b>attempt.finished</b><br/><span>raw result survives<br/>integration failure</span>"]
        SEMANTIC["<b>semantic event</b>"]
        JOURNAL["<b>RunJournal</b><br/><span>append → project → validate → commit</span>"]
        LEDGER[("<b>Hash-chained event ledger</b><br/><span>authoritative semantic history</span>")]
        BLOBS[("<b>Content-addressed blobs</b><br/><span>artifacts · prompts · lenses · schemas<br/>boundaries · traces · evidence</span>")]
        PROJECT["<b>Deterministic projectors</b><br/><span>bootstrap · work · semantics<br/>runtime · release</span>"]
        STATE["<b>Typed RunState</b><br/><span>validated in-memory projection</span>"]
        SNAPSHOT["<b>state.json</b><br/><span>best-effort cache · replay-repairable<br/>never the success boundary</span>"]
        INTENT --> START --> FINISH --> SEMANTIC --> JOURNAL --> LEDGER --> PROJECT --> STATE --> SNAPSHOT
        BLOBS --> PROJECT
    end

    INV["<b>CANONICAL INVARIANTS</b><br/><span>one exact task · one current artifact · one lossless history · explicit release debt · sparse attention · value before cost<br/>loss-aware views · full capability · task-native observation · causal negative memory · bounded commitments · fail-closed release · upstream backpropagation</span>"]

    AUTH -->|"anchors Xₜ"| CRYSTAL
    CRYSTAL -->|"projects current frontier"| LOOP
    LOOP -->|"continue or converge"| HORIZON
    HORIZON -->|"release debt becomes the bottleneck"| RELEASE
    RELEASE -->|"policy becomes execution"| RUNTIME
    RUNTIME -->|"all facts take one write path"| TRUTH
    TRUTH -->|"must preserve"| INV

